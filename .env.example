# ---------------------------------------------------------------------------
# Open-Set ReID Lab - example configuration
#
# Copy this file to ".env" (or run `python scripts/init_env.py`, which does it
# for you and fills in random access keys). The real .env is git-ignored.
# Nothing in this file is a real secret.
# ---------------------------------------------------------------------------

# --- Access control --------------------------------------------------------
# Access keys are OFF by default: the server listens on 127.0.0.1 only, so on your own
# machine nobody has to type a key (every caller acts as admin).
# To switch them on (e.g. before sharing the server with colleagues) set this to true.
REID_AUTH_REQUIRED=false

# Only used when REID_AUTH_REQUIRED=true. Three roles, three keys; the client sends one
# in the "X-API-Key" header.
#   viewer   - read-only + run re-identification queries
#   operator - viewer + manage the gallery (enroll / add images / delete)
#   admin    - operator + change thresholds, run evaluations, reset, cleanup
REID_VIEWER_KEY=replace-me-viewer
REID_OPERATOR_KEY=replace-me-operator
REID_ADMIN_KEY=replace-me-admin

# --- Web server ------------------------------------------------------------
# Browser origins allowed to call the API (comma separated).
REID_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Models ----------------------------------------------------------------
# Embedding backbone. One of: osnet_ain_x1_0, osnet_ain_x0_75, osnet_ain_x0_5, osnet_ain_x0_25
REID_EMBEDDING_MODEL=osnet_ain_x1_0
# Optional: path to a fine-tuned checkpoint produced by scripts/finetune_triplet.py
# REID_EMBEDDING_CHECKPOINT=backend/weights/finetuned/my_run.pt
# Average each embedding with the embedding of the horizontally flipped crop.
REID_USE_FLIP_TTA=false
# Merge batch-norm layers into the convolutions: same output (tested). Measured speed-up on the development
# laptop was only ~4% and inconsistent, so it is off by default (see docs/PERFORMANCE.md).
REID_FOLD_BATCH_NORM=false
# cpu | cuda | auto  (auto picks CUDA when it is available, otherwise CPU)
REID_DEVICE=auto

# Person detector (COCO "person" class). Weights are fetched by scripts/download_weights.py.
# Face + body matching (YuNet + SFace). true = the face decides when a usable face is visible; false = the original body-only
# system and the face models are never loaded. Face fingerprints are biometric data: see docs/SECURITY_AND_PRIVACY.md section 4a.
REID_FACE_MATCHING=true
REID_DETECTOR_MODEL=fasterrcnn_mobilenet_v3_large_fpn
REID_DETECTOR_MIN_SIZE=480
REID_DETECTOR_SCORE_THRESHOLD=0.5

# --- Upload limits ---------------------------------------------------------
REID_MAX_UPLOAD_MB=10
REID_MAX_IMAGE_SIDE=6000

# --- Database ----------------------------------------------------------------
# Empty = a SQLite file in backend/data/ (fine for a demo). For PostgreSQL install a driver
# (pip install "psycopg[binary]") and set e.g. postgresql+psycopg://user:password@host/dbname
# REID_DATABASE_URL=

# --- Video Explorer limits ------------------------------------------------
# A prerecorded clip is sampled frame by frame. These caps keep one upload from monopolising a small CPU.
REID_MAX_VIDEO_MB=100
REID_MAX_VIDEO_SECONDS=180
REID_MAX_VIDEO_FRAMES=120

# --- Privacy / retention ---------------------------------------------------
# Query crops kept for the history screen are deleted after this many hours.
# 0 = never store query images at all (history keeps scores only).
REID_QUERY_RETENTION_HOURS=24
# Inference history rows older than this many days are removed by cleanup.
REID_HISTORY_RETENTION_DAYS=30

# --- Starting decision policy (UNVALIDATED until you run calibration) ------
REID_DEFAULT_ACCEPT_THRESHOLD=0.70

# --- Frontend (Vite) -------------------------------------------------------
# Leave empty to use the dev proxy (recommended). Set it when the API is hosted elsewhere.
VITE_API_BASE=
